# tezcatlipoca-dashboard service configuration. Copy to .env (gitignored) and fill in.

# Where run state, worktrees, logs and evidence live (the run data dir).
TEZ_DASHBOARD_DATA=/var/lib/tezcatlipoca-dashboard

# Engine + definitions checkouts (cloned/updated by the service).
TEZ_ENGINE_REPO_URL=git@github.com:DawgSecTeam/tezcatlipoca.git
TEZ_COMPETITIONS_REPO_URL=git@github.com:DawgSecTeam/tezcatlipoca-competitions.git

# The tezcatlipoca ref a run pins when its submit names none. estate-v0.3.0 is the estate
# release: terraform is gone and a range's state is `estate-state.json`. A SHA (or the
# merge commit, once v0.3.0 lands) is the right pin for an event; provisioning fetches
# origin before cutting the worktree, so a branch name always means the fresh branch.
TEZ_ENGINE_REF=estate-v0.3.0

# Sibling services the engine expects around its worktrees (bad-auto for red01 runs;
# a pre-cloned vendor/nakon avoids submodule fetches on the run host).
TEZ_BADAUTO_PATH=
TEZ_NAKON_PATH=

# Engine environment template copied into every worktree. Either name set works: v0.3.0's
# estate/config.py prefers the canonical TEZ_PROXMOX_ENDPOINT / TEZ_PROXMOX_API_TOKEN / ...
# and still resolves the repo's legacy TF_VAR_proxmox_endpoint / TF_VAR_proxmox_api_token /
# ... names, so an existing env file needs no rewrite.
# Loaded into the SERVICE's environment, so engine knobs a run needs (TEZ_CYCLE_TIMEOUT, …)
# belong here — a run inherits this process's env, not the operator's shell.
TEZ_ENGINE_ENV_FILE=

# Optional: the engine's native profile, copied into each worktree as `tezcatlipoca.toml`
# (v0.3.0's config surface). `.env` alone is enough — estate/config.py still resolves the
# legacy TF_VAR_* names — so set this only when you want the canonical TEZ_* keys or a
# separate per-node profile (TEZ_CONFIG).
TEZ_ENGINE_CONFIG_FILE=

# The Proxmox SSH private key the engine dials VMs with (its .pub is materialized beside
# it). Forced absolute in every driver's env under both TEZ_SSH_PRIVATE_KEY_PATH and the
# legacy TF_VAR_ssh_private_key_path: the worktree is throwaway, so a relative path would
# be recorded as the range's key and be gone at teardown.
TEZ_ENGINE_PROXMOX_FILE=

# Directory holding `opencode`, prepended to each driver child's PATH. The harness's blue
# cycles exec `opencode`, which installs into ~/.opencode/bin and is NOT on a systemd unit's
# PATH; without this every cycle fails rc=127 and the run looks defended by nobody.
# Default: ~/.opencode/bin when it exists. Set empty to leave PATH alone.
TEZ_OPENCODE_BIN=

# Bearer tokens: comma-separated client-name=token. Both /api and /mcp require one.
TEZ_DASHBOARD_TOKENS=

# HTTP bind.
TEZ_DASHBOARD_HOST=127.0.0.1
TEZ_DASHBOARD_PORT=8787

# The base URL a DEPLOYED PORTAL (on an engine VM) reaches this service at — the reset-
# request sync (portal → bell). Unset: portals deploy without the channel and requests
# stay local to the portal.
TEZ_PUBLIC_URL=
